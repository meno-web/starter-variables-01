{
  "component": {
    "structure": {
      "type": "node",
      "tag": "div",
      "style": {
        "base": {
          "display": "flex",
          "flexDirection": "column",
          "justifyContent": "flex-start",
          "alignItems": "stretch",
          "backgroundColor": "var(--bg)",
          "borderRadius": "8px",
          "overflow": "hidden",
          "border": "1px solid var(--border)"
        },
        "tablet": {},
        "mobile": {}
      },
      "children": [
        {
          "type": "node",
          "tag": "img",
          "style": {
            "base": {
              "aspectRatio": "16 / 10",
              "objectFit": "cover"
            },
            "tablet": {},
            "mobile": {}
          },
          "attributes": {
            "src": "/images/placeholder-img.webp"
          }
        },
        {
          "type": "node",
          "tag": "div",
          "style": {
            "base": {
              "padding": "24px",
              "display": "flex",
              "flexDirection": "column",
              "alignItems": "flex-start",
              "gap": "12px"
            },
            "tablet": {},
            "mobile": {}
          },
          "children": [
            {
              "type": "node",
              "tag": "span",
              "style": {
                "base": {
                  "display": "inline-block",
                  "padding": "4px 12px",
                  "backgroundColor": "var(--gray-100)",
                  "borderRadius": "999px",
                  "fontSize": "14px",
                  "fontWeight": "500",
                  "color": "var(--text)"
                },
                "tablet": {},
                "mobile": {}
              },
              "children": "{{category}}"
            },
            {
              "type": "node",
              "tag": "h3",
              "style": {
                "base": {
                  "fontSize": "var(--hea-fs)",
                  "letterSpacing": "var(--h-ls)",
                  "fontWeight": "var(--h-fw)",
                  "lineHeight": "var(--h-lh)",
                  "color": "var(--text)",
                  "margin": "0"
                },
                "tablet": {},
                "mobile": {}
              },
              "children": "{{title}}"
            },
            {
              "type": "node",
              "tag": "span",
              "style": {
                "base": {
                  "fontSize": "var(--t-fs)",
                  "letterSpacing": "var(--t-ls)",
                  "fontWeight": "var(--t-fw)",
                  "color": "var(--muted)"
                },
                "tablet": {},
                "mobile": {}
              },
              "children": "{{date}}"
            },
            {
              "type": "node",
              "tag": "p",
              "style": {
                "base": {
                  "fontSize": "var(--t-fs)",
                  "letterSpacing": "var(--t-ls)",
                  "fontWeight": "var(--t-fw)",
                  "lineHeight": "var(--t-lh)",
                  "color": "var(--text)",
                  "marginTop": "4px"
                },
                "tablet": {},
                "mobile": {}
              },
              "children": "{{description}}"
            }
          ]
        }
      ]
    },
    "interface": {
      "image": {
        "type": "file",
        "default": "",
        "accept": "image/*"
      },
      "category": {
        "type": "string",
        "default": "Category"
      },
      "title": {
        "type": "string",
        "default": "Article title goes here"
      },
      "date": {
        "type": "string",
        "default": "Jan 1, 2025"
      },
      "description": {
        "type": "string",
        "default": "Short description that previews the article content."
      }
    }
  }
}