{
  "component": {
    "structure": {
      "type": "node",
      "tag": "div",
      "attributes": {
        "data-faq-item": ""
      },
      "style": {
        "base": {
          "width": "100%",
          "borderBottom": "1px solid var(--border, #e0e0e0)"
        },
        "tablet": {},
        "mobile": {}
      },
      "children": [
        {
          "type": "node",
          "tag": "button",
          "attributes": {
            "data-faq-toggle": "",
            "type": "button"
          },
          "style": {
            "base": {
              "width": "100%",
              "padding": "20px 0",
              "background": "transparent",
              "border": "none",
              "cursor": "pointer",
              "display": "flex",
              "justifyContent": "space-between",
              "alignItems": "center",
              "gap": "16px"
            },
            "tablet": {},
            "mobile": {}
          },
          "children": [
            {
              "type": "node",
              "tag": "h3",
              "style": {
                "base": {
                  "fontSize": "var(--hea-fs)",
                  "letterSpacing": "var(--h-ls)",
                  "fontWeight": "var(--h-fw)",
                  "lineHeight": "var(--h-lh)",
                  "color": "var(--text)",
                  "margin": "0",
                  "textAlign": "left",
                  "flex": "1"
                },
                "tablet": {},
                "mobile": {}
              },
              "children": [
                "{{question}}"
              ]
            },
            {
              "type": "node",
              "tag": "span",
              "attributes": {
                "data-faq-icon": ""
              },
              "style": {
                "base": {
                  "fontSize": "20px",
                  "transition": "transform 0.3s ease",
                  "display": "flex",
                  "alignItems": "center",
                  "justifyContent": "center",
                  "color": "var(--text)",
                  "flexShrink": 0
                },
                "tablet": {},
                "mobile": {}
              },
              "children": [
                "+"
              ]
            }
          ]
        },
        {
          "type": "node",
          "tag": "div",
          "attributes": {
            "data-faq-answer": ""
          },
          "style": {
            "base": {
              "maxHeight": "0",
              "overflow": "hidden",
              "transition": "max-height 0.3s ease, padding 0.3s ease",
              "paddingBottom": "0"
            },
            "tablet": {},
            "mobile": {}
          },
          "children": [
            {
              "type": "node",
              "tag": "p",
              "style": {
                "base": {
                  "fontSize": "var(--t-fs)",
                  "letterSpacing": "var(--t-ls)",
                  "fontWeight": "var(--t-fw)",
                  "lineHeight": "var(--t-lh)",
                  "color": "var(--text)",
                  "maxWidth": "530px",
                  "margin": "0 0 20px 0"
                },
                "tablet": {},
                "mobile": {}
              },
              "children": [
                "{{answer}}"
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "question": {
        "type": "string",
        "default": "First question"
      },
      "answer": {
        "type": "string",
        "default": "Short supporting description that previews how this section looks and reads in the editor"
      }
    },
    "js": "(el) => {\n  const toggle = el.querySelector('[data-faq-toggle]');\n  const answer = el.querySelector('[data-faq-answer]');\n  const icon = el.querySelector('[data-faq-icon]');\n  const item = el.querySelector('[data-faq-item]');\n  \n  if (!toggle || !answer) return;\n  \n  const updateHeight = () => {\n    if (item.getAttribute('data-expanded') === 'true') {\n      answer.style.maxHeight = answer.scrollHeight + 'px';\n      answer.style.paddingBottom = '20px';\n      icon.style.transform = 'rotate(45deg)';\n    } else {\n      answer.style.maxHeight = '0';\n      answer.style.paddingBottom = '0';\n      icon.style.transform = 'rotate(0deg)';\n    }\n  };\n  \n  toggle.addEventListener('click', () => {\n    const isExpanded = item.getAttribute('data-expanded') === 'true';\n    item.setAttribute('data-expanded', isExpanded ? 'false' : 'true');\n    updateHeight();\n  });\n  \n  // Handle window resize to adjust height\n  window.addEventListener('resize', () => {\n    updateHeight();\n  });\n}\n"
  }
}