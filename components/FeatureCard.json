{
  "component": {
    "interface": {
      "text": {
        "type": "string",
        "default": "This is heading"
      },
      "description": {
        "type": "string",
        "default": "This is heading"
      }
    },
    "structure": {
      "type": "node",
      "tag": "div",
      "style": {
        "base": {
          "padding": "16px",
          "border": "1px solid",
          "borderColor": "var(--text)"
        },
        "tablet": {},
        "mobile": {}
      },
      "children": [
        {
          "type": "node",
          "tag": "h2",
          "style": {
            "base": {
              "fontSize": "var(--hea-fs)",
              "letterSpacing": "var(--h-ls)",
              "fontWeight": "var(--h-fw)",
              "marginBottom": "var(--h-m)"
            },
            "tablet": {},
            "mobile": {}
          },
          "children": [
            "{{text}}"
          ]
        },
        {
          "type": "node",
          "tag": "p",
          "style": {
            "base": {
              "fontSize": "var(--t-fs)",
              "letterSpacing": "var(--t-ls)",
              "fontWeight": "var(--t-fw)"
            },
            "tablet": {},
            "mobile": {}
          },
          "children": [
            "{{description}}"
          ]
        }
      ]
    }
  }
}